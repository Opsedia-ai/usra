# Usra Supabase backend — environment variables.
# Copy to supabase/.env (read by the CLI for config.toml) and supabase/functions/.env
# (read by `supabase functions serve`). Placeholders only. Never commit real values.
# In hosted projects, set them with: supabase secrets set --env-file <file>
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# Edge Functions by Supabase; don't set them yourself.

# --- Auth: Send SMS hook (Standard Webhooks secret, from the Auth Hooks page) ---
# Format "v1,whsec_<base64>". Several may be joined with "|" to rotate.
SEND_SMS_HOOK_SECRETS=v1,whsec_REPLACE_ME

# SMS provider: unifonic | twilio
SMS_PROVIDER=unifonic
UNIFONIC_APP_SID=REPLACE_ME
UNIFONIC_SENDER_ID=Usra
# UNIFONIC_BASE_URL=https://el.cloud.unifonic.com
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
# Messaging Service SID (MG...) or sender number
TWILIO_FROM=REPLACE_ME
# Optional 11-character Android SMS Retriever hash appended to the OTP text
SMS_ANDROID_APP_HASH=

# --- LLM (AI Doctor and cloud OCR) ---
ANTHROPIC_API_KEY=REPLACE_ME
# ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_DOCTOR_MODEL=claude-sonnet-5-5
AI_DOCTOR_CREDIT_COST=1
AI_DOCTOR_MAX_OUTPUT_TOKENS=2000

OCR_MODEL=claude-haiku-5-5
OCR_MONTHLY_LIMIT=20
OCR_QUOTA_WINDOW_DAYS=30
OCR_BURST_PER_MINUTE=5

# --- RevenueCat ---
# Same value as the Authorization header configured on the RevenueCat webhook
REVENUECAT_WEBHOOK_SECRET=REPLACE_ME
# Consumable product id -> credits (JSON)
REVENUECAT_CREDIT_PACKS={"usra_credits_5":5,"usra_credits_20":20}
REVENUECAT_PLUS_ENTITLEMENT=plus
PLUS_CREDITS_PER_PERIOD=10
REVENUECAT_ALLOW_SANDBOX=false
