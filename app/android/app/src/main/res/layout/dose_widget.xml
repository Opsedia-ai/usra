<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the next three doses today (DoseWidgetProvider).
     Big text for elders; the whole widget opens the Medicines tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dose_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dose_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/dose_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="start"
        android:text="@string/dose_widget_name"
        android:textAlignment="viewStart"
        android:textColor="@color/dose_widget_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <include
        android:id="@+id/dose_row_1"
        layout="@layout/dose_widget_row_1" />

    <include
        android:id="@+id/dose_row_2"
        layout="@layout/dose_widget_row_2" />

    <include
        android:id="@+id/dose_row_3"
        layout="@layout/dose_widget_row_3" />

    <TextView
        android:id="@+id/dose_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/dose_widget_empty"
        android:textAlignment="viewStart"
        android:textColor="@color/dose_widget_text"
        android:textSize="22sp" />
</LinearLayout>
