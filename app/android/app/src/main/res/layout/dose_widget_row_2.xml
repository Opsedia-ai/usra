<?xml version="1.0" encoding="utf-8"?>
<!-- One dose on the widget: "٨:٠٠ م – ميعاد جرعة" and, once due, Taken. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
        android:id="@+id/dose_text_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="@color/dose_widget_text"
        android:textSize="22sp" />

    <Button
        android:id="@+id/dose_taken_2"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/dose_widget_button"
        android:minWidth="72dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/dose_widget_taken"
        android:textColor="@color/dose_widget_on_accent"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
